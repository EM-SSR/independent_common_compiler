cabal-version: 2.4
name: counter-plane
version: 0.1.0.0
synopsis: GCLS implementation

library
  hs-source-dirs:
    src/core
    src/dag
    src/category/gcls_category
    src/category/normalized_bool
    src/category/counter_compute_system
  exposed-modules:
    CounterType
    CounterConstraints
    RealUnit
    CounterInteger
    CounterUnits
    CounterExtend
    DagPlane
    DagArith
    DagInfluence
    CounterDag
    Quantale
    GclsCategory
    EnrichedG
    ConstructCalculus
    Foundations
    NormalizedBool
    CounterComputeSystem
  build-depends:
    base >=4 && <5
  default-language: Haskell2010
  ghc-options: -Wall
