cabal-version: 2.4
name: common-national-language
version: 0.1.0.0
synopsis: Common National Language

library
  hs-source-dirs:
    src/chamber
    src/word
    src/grammar
    src/info
    src/totality
    src/multimodal
    src/speech
    src/noun
    src/learn
    src/text
  exposed-modules:
    CommonChamber
    JoinRank
    Ideogram
    SparseTensor
    SentenceGrammar
    InfoTheory
    Totality
    Multimodal
    Speech
    Abbrev
    NounNet
    Metanoun
    PathAlgebra
    PlainText
  build-depends:
    base >=4 && <5
    , counter-plane
  default-language: Haskell2010
  ghc-options: -Wall
